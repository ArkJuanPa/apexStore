# Copie este archivo como .env en la raíz del proyecto. .env no se versiona.
# Las variables comentadas son opcionales: si faltan, el código usa su valor por defecto.

# PostgreSQL (lo lee Nodo 4). Use los valores de su instancia; no suba la contraseña real.
DB_MODO=externo
DB_HOST=localhost
DB_PORT=5433
DB_NOMBRE=apex
DB_USUARIO=postgres
DB_PASSWORD=cambiar-por-la-clave-real
DB_ESQUEMA=public
DB_CREAR_BASE_SI_NO_EXISTE=false
# DB_SSLMODE=disable
# DB_POOL_MAX=20
# DB_ESPERA_MAX_SEG=60
